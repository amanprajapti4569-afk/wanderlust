<% layout('/layouts/boilerplate') -%>

<h1 class="mb-4">All listings</h1>

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    <% for (const listing of allListing) { %>
        <div class="col">
            <a class="listing-card-link" href="/listings/<%= listing._id %>">
                <article class="card listing-card h-100">
                    <img
                        src="<%= listing.image?.url || listing.image || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=900&q=80' %>"
                        class="card-img-top"
                        alt="<%= listing.title %>"
                    >
                    <div class="card-body">
                        <h2 class="card-title h5"><%= listing.title %></h2>
                        <p class="card-text text-muted">
                            <%= listing.location %><%= listing.location && listing.country ? ', ' : '' %><%= listing.country %>
                        </p>
                        <p class="card-text">
                            <%= listing.description || 'Discover this unique place to stay.' %>
                        </p>
                        <% if (listing.price != null) { %>
                            <p class="card-text fw-semibold mb-0">
                                &#8377;<%= Number(listing.price).toLocaleString('en-IN') %> / night
                            </p>
                        <% } %>
                    </div>
                </article>
            </a>
        </div>
    <% } %>
</div>

<% if (allListing.length === 0) { %>
    <p class="text-muted">No listings yet. Add the first one to get started.</p>
<% } %>
